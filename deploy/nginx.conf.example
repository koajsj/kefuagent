# Include this file from the nginx http {} context, not from server {}.
# Replace the domain and certificate paths. Thresholds are examples: size and
# tune them for the deployment, then verify with representative traffic.
# Nginx directly faces clients; if a trusted proxy precedes it, configure and
# audit real-IP handling for known immediate peers before using $binary_remote_addr.
# This example has not been checked with nginx -t or deployed.
# Local Uvicorn: --proxy-headers --forwarded-allow-ips=127.0.0.1.
# Container images default to --no-proxy-headers: override with the actual known
# immediate peer IP; a container gateway is not 127.0.0.1. Never use *.
limit_req_zone $binary_remote_addr zone=support_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=support_connections:10m;

server {
    listen 80;
    server_name support.example.com;
    return 308 https://support.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name support.example.com;
    ssl_certificate /etc/ssl/support.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/support.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Enable HSTS only after confirming the entire domain is served over HTTPS.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    # Example disables access logs; configure operational monitoring separately.
    # Review error logs too: disabling access logs is not a confidentiality guarantee.
    access_log off;
    client_max_body_size 6m;
    client_header_timeout 15s;
    client_body_timeout 30s;
    keepalive_timeout 30s;
    send_timeout 30s;
    large_client_header_buffers 4 8k;

    location / {
        limit_req zone=support_requests burst=30 nodelay;
        limit_req_status 429;
        limit_conn support_connections 20;
        limit_conn_status 429;
        # No trailing slash: preserve /api paths and all other request URIs.
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_send_timeout 30s;
        proxy_read_timeout 180s;
    }
}
