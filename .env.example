# Create a dedicated PostgreSQL database. Runtime role must be NOSUPERUSER NOBYPASSRLS.
DATABASE_URL=postgresql+psycopg://support_app:CHANGE_ME@127.0.0.1:5432/support_agent
# Migration owner URL; never used by HTTP requests. Omit when the same dedicated role owns tables.
# MIGRATION_DATABASE_URL=postgresql+psycopg://support_owner:CHANGE_ME@127.0.0.1:5432/support_agent
SESSION_HOURS=12
# Controlled local UUID-addressed storage. Never point this to backups or public static files.
DOCUMENT_STORAGE_ROOT=.local/documents
# Exact deployment-approved hostnames; HTTPS:443 only, no private IPs, redirects or environment proxy.
MODEL_ALLOWED_HOSTS=[]
# External secret: base64url encoding of 32 cryptographically random bytes. No default/fallback.
# CREDENTIAL_MASTER_KEY=BASE64URL_ENCODED_32_RANDOM_BYTES
