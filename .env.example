# Create a dedicated PostgreSQL database. Runtime role must be NOSUPERUSER NOBYPASSRLS.
DATABASE_URL=postgresql+psycopg://support_app:CHANGE_ME@127.0.0.1:5432/support_agent
# Migration owner URL; never used by HTTP requests. Omit when the same dedicated role owns tables.
# MIGRATION_DATABASE_URL=postgresql+psycopg://support_owner:CHANGE_ME@127.0.0.1:5432/support_agent
SESSION_HOURS=12
# Controlled local UUID-addressed storage. Never point this to backups or public static files.
DOCUMENT_STORAGE_ROOT=.local/documents
# Exact deployment-approved hostnames; HTTPS:443 only, no private IPs, redirects or environment proxy.
MODEL_ALLOWED_HOSTS=[]
# External secret: base64url encoding of 32 cryptographically random bytes. No default/fallback.
# CREDENTIAL_MASTER_KEY=BASE64URL_ENCODED_32_RANDOM_BYTES

# Model admission across workers, PostgreSQL-backed. Limits apply to each tenant/user/Agent.
TENANT_REQUESTS_PER_MINUTE=120
USER_REQUESTS_PER_MINUTE=60
AGENT_REQUESTS_PER_MINUTE=90
TENANT_CONCURRENT_CALLS=8
USER_CONCURRENT_CALLS=2
AGENT_CONCURRENT_CALLS=4
# UTC daily conservative reservations; not monetary billing limits.
TENANT_DAILY_TOKEN_BUDGET=5000000
USER_DAILY_TOKEN_BUDGET=3000000
AGENT_DAILY_TOKEN_BUDGET=4000000

# Same origin of Web/API, exact match. HTTP is allowed for local loopback development only.
WEB_ORIGIN=http://127.0.0.1:8000
# Disabled by default. Deployment owner may explicitly enable after selecting Provider/model/budget.
# No real external model connections are performed during this phase.
ALLOW_EXTERNAL_MODELS=false
# At least 32 random characters; required for anonymous session creation, no default.
# PUBLIC_RATE_KEY=YOUR_INDEPENDENT_RANDOM_SECRET

# Optional versioned AES-GCM keyring. Values are secrets, IDs are not.
# Keep legacy keys while any database/backup needs them; see docs/P7_RUNTIME.md.
# CREDENTIAL_KEYRING={"key_2026":"BASE64URL_ENCODED_32_RANDOM_BYTES"}
# CREDENTIAL_ACTIVE_KEY=key_2026

# Retention is disabled by default; no scheduler is installed.
# Business periods >=2 days; audit >=30 days. CLI preview never deletes.
# RETENTION_CONVERSATIONS_DAYS=90
# RETENTION_VISITORS_DAYS=30
# RETENTION_CALLS_DAYS=90
# RETENTION_AUDIT_DAYS=365
